model TimeOffRequest {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  type       TimeOffType
  status     TimeOffStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  hours      Int
  reason     String?
  reviewedBy String?
  reviewer   User?         @relation("TimeOffReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("time_off_requests")
}

model TimeOffBalance {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  type      TimeOffType
  year      Int
  allocated Float
  used      Float       @default(0)
  pending   Float       @default(0)
  remaining Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, type, year])
  @@map("time_off_balances")
}

model TimeOffPolicy {
  id               String      @id @default(uuid())
  name             String
  type             TimeOffType
  daysAllowed      Float
  carryOverAllowed Boolean     @default(false)
  maxCarryOverDays Float?
  requiresApproval Boolean     @default(true)
  minNoticeDays    Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("time_off_policies")
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  HOLIDAY
  OTO
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
